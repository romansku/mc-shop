generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model mshop_items {
  id                          BigInt              @id @default(autoincrement())
  item_type                   mshop_item_item_type
  data                        String              @db.VarChar(150)
  amount                      Int                 @default(1)
  category_id                 BigInt?
  name                        String              @unique(map: "uq__mshop_items__name") @db.VarChar(25)
  description                 String              @db.VarChar(500)
  favorite                    Boolean             @default(false)
  prioritization              Int
  price                       Decimal             @db.Decimal(10, 2)
  image_link                  String?             @db.VarChar(512)
  active                      Boolean             @default(false)
  mshop_categories            mshop_categories?   @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_mshop_items_category")
  mshop_item_packs_as_parent  mshop_item_packs[]  @relation("ItemPackParent")
  mshop_item_packs_as_child   mshop_item_packs[]  @relation("ItemPackChild")
  mshop_order_items           mshop_order_items[]

  @@index([category_id], map: "idx_mshop_items_category_id")
}

model mshop_categories {
  id          BigInt        @id @default(autoincrement())
  name        String        @db.VarChar(255)
  description String        @db.LongText
  mshop_items mshop_items[]
}

model mshop_item_packs {
  parent_item_id BigInt
  child_item_id  BigInt
  parent_item    mshop_items @relation("ItemPackParent", fields: [parent_item_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk__item_pack__parent_item_id__item__id")
  child_item     mshop_items @relation("ItemPackChild", fields: [child_item_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk__item_pack__child_item_id__item__id")

  @@id([parent_item_id, child_item_id])
  @@index([child_item_id], map: "idx__item_pack__child_item_id")
}

model mshop_player_orders {
  id                    BigInt                @id @default(autoincrement())
  user_name             String                @db.VarChar(25)
  email                 String                @db.VarChar(255)
  payment_method        mshop_payment_method
  payment_type          String?               @db.VarChar(32)
  amount                Decimal               @db.Decimal(12, 2)
  net_amount            Decimal?              @db.Decimal(12, 2)
  amount_currency       String                @default("RUB") @db.VarChar(8)
  created_date          DateTime?             @default(now()) @db.Timestamp(0)
  delivered_date        DateTime?             @db.Timestamp(0)
  payment_id            BigInt?
  yoomoney_operation_id String?               @unique(map: "uq_mshop_player_orders_yoomoney_operation_id") @db.VarChar(64)
  yoomoney_sender       String?               @db.VarChar(32)
  yoomoney_payload      String?               @db.LongText
  status                mshop_order_status
  mshop_order_items     mshop_order_items[]

  @@index([payment_method], map: "idx_mshop_player_orders_payment_method")
  @@index([status], map: "idx_mshop_player_orders_status")
  @@map("mshop_player_orders")
}

model mshop_players {
  uuid       String   @id @db.Char(36)
  username   String   @db.VarChar(25)
  registered Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamp(0)

  @@index([username], map: "idx_mshop_players_username")
  @@map("mshop_players")
}

model mshop_order_items {
  order_id             BigInt
  item_id              BigInt
  mshop_player_orders  mshop_player_orders @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk__order_item__order_id__player_order__id")
  mshop_items          mshop_items         @relation(fields: [item_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk__order_item__item_id__item__id")

  @@id([order_id, item_id])
  @@index([item_id], map: "fk__order_item__item_id__item__id")
  @@map("mshop_order_items")
}

enum mshop_item_item_type {
  COMMAND
  ITEM
  PACK
}

enum mshop_payment_method {
  CRYPTO
  PAYPAL
  YOOMONEY
}

enum mshop_order_status {
  DRAFT
  CREATED
  PAID
  COMPLETED
  CANCELLED
}
